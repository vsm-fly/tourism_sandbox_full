{% extends 'base.html' %}
{% block title %}Панель — Tourism Sandbox{% endblock %}
{% block content %}

  <!-- ЛОГО по центру -->
  <div class="text-center mb-2">
    <img src="{{ url_for('static', filename='img/logo.png') }}" alt="Логотип" class="dash-logo-img">
  </div>

  <!-- Заголовок и бейдж по центру -->
  <h1 class="h4 text-center mb-2">Панель управления</h1>
  <div class="text-center mb-4">
    <span class="badge bg-success">{{ 'Администратор' if user.is_admin else 'Пользователь' }}</span>
  </div>

  <p class="text-muted text-center">
    Это «песочница». Ниже — карточки модулей. Клик по карточке пока никуда не ведёт — дальше подключим реальные блюпринты.
  </p>

  <div class="row g-3 mt-2">
    {% set modules = [
      {"title": "Касса", "desc": "Учёт операций кассы", "icon": "💵"},
      {"title": "Банк", "desc": "Платежи и выписки", "icon": "🏦"},
      {"title": "Авиабилеты", "desc": "Реестры продаж", "icon": "✈️"},
      {"title": "Внутренний туризм", "desc": "Заказы и маржа", "icon": "🏞️"},
      {"title": "Внешний туризм", "desc": "Пакеты и отчёты", "icon": "🌍"},
    ] %}

    {% for m in modules %}
      <div class="col-12 col-sm-6 col-lg-4">
        <a class="card module-card h-100" href="#" tabindex="0">
          <div class="card-body">
            <div class="display-6">{{ m.icon }}</div>
            <h2 class="h5 mt-2 mb-1">{{ m.title }}</h2>
            <p class="text-muted mb-0">{{ m.desc }}</p>
          </div>
        </a>
      </div>
    {% endfor %}

    {% if user.is_admin %}
      <div class="col-12 col-sm-6 col-lg-4">
        <a class="card module-card h-100 border-dashed" href="#">
          <div class="card-body d-flex align-items-center justify-content-center text-center">
            <div>
              <div class="display-6">➕</div>
              <div class="h6 mt-2">Добавить новый модуль</div>
              <div class="text-muted small">(доступно только администратору)</div>
            </div>
          </div>
        </a>
      </div>
    {% endif %}
  </div>
{% endblock %}
