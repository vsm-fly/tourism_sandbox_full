{% extends "base.html" %}
{% block content %}
<div class="container py-4">
  <h4 class="mb-3">РќРѕРІР°СЏ РѕРїРµСЂР°С†РёСЏ (Р‘Р°РЅРє)</h4>
  <form method="post">
    <!-- CSRF С‚РѕРєРµРЅ РѕР±СЏР·Р°С‚РµР»РµРЅ -->
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label">Р”Р°С‚Р° РѕРїРµСЂР°С†РёРё</label>
        <input type="date" name="date_op" class="form-control" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">Р‘Р°РЅРє</label>
        <select name="bank_name" class="form-select" required>
          {% for b in banks %}<option value="{{ b }}">{{ b }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">в„– СЃС‡С‘С‚Р° (20 Р·РЅР°РєРѕРІ)</label>
        <select name="account_number" class="form-select" required>
          {% for a in accounts %}<option value="{{ a.number }}">{{ a.number }}</option>{% endfor %}
        </select>
        <div class="form-text">РЎС‡РµС‚Р° РґРѕР±Р°РІР»СЏСЋС‚СЃСЏ РІ СЃРїСЂР°РІРѕС‡РЅРёРєРµ В«РЎС‡РµС‚Р° Р±Р°РЅРєР°В»</div>
      </div>
      <div class="col-md-3">
        <label class="form-label">Р Р°Р·РґРµР»</label>
        <select name="section" class="form-select" required>
          <option>РџСЂРёС…РѕРґ</option>
          <option>Р Р°СЃС…РѕРґ</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">РљРѕРґ РєР»РёРµРЅС‚Р°</label>
        <select id="client_code" name="client_code" class="form-select" required>
          {% for c in codes %}<option value="{{ c.code }}">{{ c.code }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">РќР°РёРјРµРЅРѕРІР°РЅРёРµ РєР»РёРµРЅС‚Р°</label>
        <input id="client_name" name="client_name" class="form-control" readonly>
      </div>

      <div class="col-12">
        <label class="form-label">РћСЃРЅРѕРІР°РЅРёРµ</label>
