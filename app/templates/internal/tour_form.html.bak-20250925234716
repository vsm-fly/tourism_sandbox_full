{% block scripts %}
<script>
(function() {
  const sel = (q) => document.querySelector(q);

  function toNum(v) {
    if (v == null) return 0;
    return parseFloat(String(v).replace(/\s+/g,'').replace(',', '.')) || 0;
  }
  function setVal(input, val, digits=2, suffix='') {
    if (!input) return;
    const n = (Math.round(val * Math.pow(10, digits)) / Math.pow(10, digits)).toFixed(digits);
    input.value = suffix ? (n + suffix) : n;
  }

  const cost  = sel('[name="cost"]');
  const price = sel('[name="price"]');
  const net   = sel('[name="net"]');
  const mrg   = sel('[name="margin"]');

  function recalc() {
    const c = toNum(cost && cost.value);
    const p = toNum(price && price.value);
    const n = p - c;
    const m = p > 0 ? (n * 100 / p) : 0;
    setVal(net, n, 2);
    setVal(mrg, m, 1);
  }

  if (cost)  cost.addEventListener('input', recalc);
  if (price) price.addEventListener('input', recalc);
  recalc();
})();
</script>
{% endblock %}

