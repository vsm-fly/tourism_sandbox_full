    </div>

    <div class="mt-4">
      <button class="btn btn-primary">РЎРѕС…СЂР°РЅРёС‚СЊ</button>
      <a class="btn btn-outline-secondary" href="{{ url_for('banks.list_ops') }}">РћС‚РјРµРЅР°</a>
    </div>
  </form>
</div>

<script>
  function recalc() {
    const r = parseFloat(document.getElementById('rate').value || '0');
    const n = parseFloat(document.getElementById('nominal').value || '0');
    document.getElementById('equivalent').value = (r*n).toFixed(4);
  }
  document.getElementById('rate').addEventListener('input', recalc);
  document.getElementById('nominal').addEventListener('input', recalc);
  recalc();

  const codeSel = document.getElementById('client_code');
  const nameInp = document.getElementById('client_name');
  async function fillName() {
    const resp = await fetch(`/banks/api/ref-code/${codeSel.value}`);
    const data = await resp.json();
    nameInp.value = data.name || "";
  }
  codeSel.addEventListener('change', fillName);
  fillName();
</script>
{% endblock %}

