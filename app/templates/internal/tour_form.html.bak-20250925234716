      </div>
      <div class="col-md-2">
        <label class="form-label">РљСѓСЂСЃ</label>
        <input id="rate" name="rate" type="number" step="0.0001" class="form-control" value="1.0000" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">РќРѕРјРёРЅР°Р»</label>
        <input id="nominal" name="nominal" type="number" step="0.0001" class="form-control" value="0.0000" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Р­РєРІРёРІР°Р»РµРЅС‚</label>
        <input id="equivalent" name="equivalent" type="number" step="0.0001" class="form-control" value="0.0000" readonly>
      </div>

      <div class="col-12">
        <label class="form-label">РџСЂРёРјРµС‡Р°РЅРёРµ</label>
