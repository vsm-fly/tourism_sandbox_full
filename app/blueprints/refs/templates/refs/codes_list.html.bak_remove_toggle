{% extends "base.html" %}
{% block title %}Справочник кодов{% endblock %}

{% block content %}
<div class="container py-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h3 class="m-0">Справочник кодов</h3>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="{{ url_for('refs.codes_export_xlsx', **request.args) }}">
        <i class="bi bi-file-earmark-excel"></i> Экспорт Excel
      </a>
      <a class="btn btn-outline-primary" href="{{ url_for('refs.codes_import') }}">
        <i class="bi bi-upload"></i> Импорт Excel
      </a>
      <a class="btn btn-primary" href="{{ url_for('refs.codes_new') }}">
        <i class="bi bi-plus-lg"></i> Добавить код
      </a>
    </div>
  </div>

  <!-- Фильтры -->
  <form class="card card-body mb-3" method="get" action="{{ url_for('refs.codes_list') }}">
    <div class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label">Поиск</label>
        <input name="q" value="{{ q }}" class="form-control" placeholder="Код / Наименование / Тип">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label">Тип</label>
        <select name="type_id" class="form-select">
          <option value="0">Все типы</option>
          {% for t in types %}
            <option value="{{ t.id }}" {% if type_id == t.id %}selected{% endif %}>{{ t.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label">Статус</label>
        <select name="status" class="form-select">
          <option value="">Любой</option>
          <option value="active"  {% if status == 'active' %}selected{% endif %}>Активен</option>
          <option value="inactive"{% if status == 'inactive' %}selected{% endif %}>Не активен</option>
        </select>
      </div>
      <div class="col-6 col-md-1">
        <label class="form-label">На странице</label>
        <select name="per_page" class="form-select">
          {% for n in [10,20,50,100] %}
            <option value="{{ n }}" {% if per_page == n %}selected{% endif %}>{{ n }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-12 col-md-1 d-grid">
        <button class="btn btn-secondary">Фильтр</button>
      </div>
      <div class="col-12 col-md-1 d-grid">
        <a class="btn btn-outline-secondary" href="{{ url_for('refs.codes_list') }}">Сброс</a>
      </div>
    </div>
  </form>

  <div class="card">
    <div class="card-body pb-0">
      <form method="post" action="{{ url_for('refs.codes_batch', **request.args) }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div class="d-flex flex-wrap gap-2 mb-2">
          <select name="action" id="batchAction" class="form-select" style="max-width:220px">
            <option value="">Действие...</option>
            <option value="activate">Сделать активными</option>
            <option value="deactivate">Сделать неактивными</option>
            <option value="delete">Удалить выбранные</option>
            <option value="set_type">Установить тип</option>
          </select>
          <select name="type_id" id="batchType" class="form-select d-none" style="max-width:260px">
            <option value="0"> Выберите тип </option>
            {% for t in types %}
              <option value="{{ t.id }}">{{ t.name }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn-outline-primary" id="batchDo">Применить</button>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width:42px"><input class="form-check-input" type="checkbox" id="checkAll"></th>
                <th>Код</th>
                <th>Наименование</th>
                <th>Тип</th>
                <th>Статус</th>
                <th class="text-end">Действия</th>
              </tr>
            </thead>
            <tbody>
            {% for it in items %}
              <tr>
                <td><input class="form-check-input row-check" type="checkbox" name="ids" value="{{ it.id }}"></td>
                <td><span class="fw-semibold">{{ it.code }}</span></td>
                <td>{{ it.name }}</td>
                <td>{{ it.type.name }}</td>
                <td>
                  {% if it.status == 'active' %}
                    <span class="badge text-bg-success">Активен</span>
                  {% else %}
                    <span class="badge text-bg-secondary">Не активен</span>
                  {% endif %}
                </td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-primary" href="{{ url_for('refs.codes_edit', item_id=it.id, **request.args) }}" title="Редактировать">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form method="post" action="{{ url_for('refs.codes_toggle', item_id=it.id, **request.args) }}" class="d-inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Переключить статус">
                      <i class="bi bi-shuffle"></i>
                    </button>
                  </form>
                  <form method="post" action="{{ url_for('refs.codes_delete', item_id=it.id, **request.args) }}" class="d-inline js-delete" data-name="{{ it.code }}  {{ it.name }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6" class="text-center text-muted py-4">Ничего не найдено</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </form>
    </div>
  </div>

  {% if pagination.pages > 1 %}
  <nav class="mt-3">
    <ul class="pagination mb-0">
      <li class="page-item {% if not pagination.has_prev %}disabled{% endif %}">
        <a class="page-link" href="{{ url_for('refs.codes_list', page=pagination.prev_num if pagination.has_prev else 1, **request.args) }}"></a>
      </li>
      {% for p in range(1, pagination.pages + 1) %}
        <li class="page-item {% if p == pagination.page %}active{% endif %}">
          <a class="page-link" href="{{ url_for('refs.codes_list', page=p, **request.args) }}">{{ p }}</a>
        </li>
      {% endfor %}
      <li class="page-item {% if not pagination.has_next %}disabled{% endif %}">
        <a class="page-link" href="{{ url_for('refs.codes_list', page=pagination.next_num if pagination.has_next else pagination.pages, **request.args) }}"></a>
      </li>
    </ul>
  </nav>
  {% endif %}
</div>
{% endblock %}

